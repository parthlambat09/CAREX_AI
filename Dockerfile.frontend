FROM node:20-alpine

WORKDIR /app

# Copy package files first for layer caching
COPY package.json package-lock.json ./

# Install Node dependencies
RUN npm ci

# Copy full frontend application source
COPY . .

EXPOSE 5173

ENV HOST=0.0.0.0 \
    PORT=5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
